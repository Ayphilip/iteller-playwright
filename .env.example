BASE_URL=http://localhost:8010
TEST_USERNAME=
TEST_PASSWORD=
# Optional: branch name as shown in the dropdown (defaults to first option)
TEST_BRANCH=
# Optional: only needed if the user has 2FA enabled
TEST_OTP=

# --- NEFT Outward Transfers (tests/neft-outward-transfers.spec.ts) ---
# Customer account entered on the Transfers(CR) form (CR debits it, so it needs balance)
TRANSFER_ACCOUNT_NO=
# Beneficiary bank name as shown in the dropdown (partial match ok; first bank if empty)
BENEFICIARY_BANK=
# 10-digit beneficiary account number (must pass NUBAN validation for that bank)
BENEFICIARY_ACCOUNT_NO=
TRANSFER_AMOUNT=1000
# Optional overrides for Transfers(DR); default to the CR values above
DR_ACCOUNT_NO=
PAYER_BANK=
PAYER_ACCOUNT_NO=
DR_AMOUNT=

# --- Second user who views Approval > Pending Transfers ---
APPROVER_USERNAME=
APPROVER_PASSWORD=
APPROVER_BRANCH=
APPROVER_OTP=
# Reason used when disapproving. Leave empty to pick the first reason the app lists.
DISAPPROVAL_REASON=

# Backend log tracking (attached to each test in the HTML report). Set TRACK_LOGS=false to disable.
TRACK_LOGS=true
# ITELLER_API_LOG_DIR=C:/inetpub/wwwroot/iTellerEnterpriseAPI/logs
# CUSTOMER_DETAILS_DIR=C:/inetpub/wwwroot/CustomerDetailsservicechEnterprise

# --- Outward transmission (Clearing > Generate Presentment Files) ---
# Folder CustomerDetails writes OPFData_<bank>_<date>_<msgId>.xml to (Web.config OutwardFilePath4iTeller)
OUTWARD_FILE_DIR=E:/MyOutward
# Cheques | NEFT | Both
PRESENTMENT_TRANS_TYPE=NEFT
# Seconds to wait for the iTellerTransmitter service to pick the file up (0 = stop after the file is generated)
PICKUP_WAIT_SECONDS=180
# iTeller Transmitter logs (defaults shown)
# TRANSMITTER_DIR=C:/Program Files (x86)/PFS/iTeller Transmitter
# TRANSMITTER_LOG_DIR=E:/TransmiterLog

# --- NEFT Inward (file -> Clearing > NEFT Inward -> Double Entry Generation NEFT) ---
# Account the test inward credits go to, and its exact name in the core banking system
# (perfect match = this name; partial match = first name + other word; no match = unrelated name)
INWARD_ACCOUNT_NO=1234567890
INWARD_ACCOUNT_NAME=Opeloyemi Self
# Bank code / receiving sort code in generated inward files (empty = the logged-in branch, e.g. 103150019 -> bank 103)
INWARD_BANK_CODE=
INWARD_SORT_CODE=
# Return reason for the no-match item (empty = first reason listed)
INWARD_RETURN_REASON=
# Inward folder. Empty = the InwardFilesService's configured FilePath (currently C:\MyInward)
INWARD_FILE_DIR=
# Seconds to wait for the InwardFilesService (checks every 3 minutes) to pick the file up
INWARD_PICKUP_WAIT_SECONDS=420

# --- Cheque Inward (file -> Pre Treatment -> View > Double Entries -> Full Treatment [-> Return Request File Transmission]) ---
# Account the test cheques are drawn on (empty = INWARD_ACCOUNT_NO)
INWARD_CHEQUE_ACCOUNT_NO=
# Archived cheque inward file whose images are reused (empty = newest one with images in the inward Archive folders)
INWARD_CHEQUE_SAMPLE=
# Seconds the reviewer keeps the mandate open in Full Treatment
MANDATE_VIEW_SECONDS=5
# Return reason for the returned cheque (empty = first reason listed)
CHEQUE_RETURN_REASON=
# Cheque Zone on the cheque Double Entries page (empty = first zone listed, e.g. SMDINW)
CHEQUE_ZONE=

# --- Cheque outward (tests/cheque-outward) ---
# The scanner (Scan Outward Cheque Web/Lite > Launch Scanner) is a Windows desktop app the test
# can't drive, so the test saves the cheque through the scanner's CustomerDetails service calls.
# Account the cheque is lodged into (defaults to INWARD_ACCOUNT_NO); Web scans validate it on the CBA.
OUTWARD_CHEQUE_ACCOUNT_NO=
OUTWARD_CHEQUE_ACCOUNT_NAME=
# Paying bank sort code (another bank) and the drawer's account there.
OUTWARD_CHEQUE_SORT_CODE=011173117
OUTWARD_CHEQUE_DRAWER_ACCOUNT_NO=2005866533
OUTWARD_CHEQUE_DRAWER=PLAYWRIGHT DRAWER
# Scanner to pick on the scan page (default: the first listed).
WEB_SCANNER=
LITE_SCANNER=
# standard = saveScannedCheques, uv = saveScannedChequesUV (needs sp_insert_cheque_direct_activex_UV).
SCANNER_SAVE_METHOD=standard
# Black-and-white TIFFs (chequeImageBW): needed for the cheque to go into the presentment file.
SCANNER_BW_IMAGES=true
# CustomerDetails service the scanner calls.
CUSTOMER_DETAILS_URL=http://localhost/CustomerDetailsservicechEnterprise/DepotelCustomerDetails.asmx

# --- Treat Return Inward (tests/return-inward) ---
# Return files (IRFData_...) return our most recent transmitted, not-yet-returned items, looked up
# read-only in the iTeller database with sqlcmd (Windows login).
RETURN_INWARD_REASON=02
RETURN_INWARD_COUNT=1
ITELLER_DB_SERVER=.
ITELLER_DB_NAME=iTELLEREnterprise
